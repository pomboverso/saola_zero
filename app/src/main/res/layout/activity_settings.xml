<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    style="@style/VerticalList"
    android:layout_height="match_parent"
    android:background="@color/base"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <TextView
        style="@style/H2"
        android:text="@string/header_settings" />

    <View style="@style/SeparatorListVertical" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:cacheColorHint="@android:color/transparent"
        android:fadingEdge="none"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout style="@style/VerticalList">

            <com.rama.okapi_zero.widgets.WdCollapsibleSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:defaultExpanded="true"
                app:header="@string/header_system"
                app:key="settings:section:system">

                <Button
                    android:id="@+id/hid_setup_btn"
                    style="@style/BTN"
                    android:text="@string/btn_hid_setup" />

                <TextView
                    android:id="@+id/hid_setup_log"
                    style="@style/Text"
                    android:textIsSelectable="true"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <View style="@style/SeparatorListVertical" />

                <com.rama.okapi_zero.widgets.WdCheckbox
                    android:id="@+id/show_status_bar"
                    style="@style/Checkbox"
                    android:text="@string/label_show_status_bar" />

                <View style="@style/SeparatorListVertical" />

                <com.rama.okapi_zero.widgets.WdCheckbox
                    android:id="@+id/keep_screen_awake"
                    style="@style/Checkbox"
                    android:text="@string/label_keep_screen_awake" />

                <View style="@style/SeparatorListVertical" />

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_app_zoom" />

                    <View style="@style/SeparatorListVertical" />

                    <LinearLayout style="@style/HorizontalList">

                        <EditText
                            android:id="@+id/zoom"
                            style="@style/EditText"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="3"
                            android:text="100" />

                        <View style="@style/SeparatorListHorizontal" />

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:text="@string/label_zoom_unit" />
                    </LinearLayout>
                </LinearLayout>
            </com.rama.okapi_zero.widgets.WdCollapsibleSection>

            <View style="@style/SeparatorListVertical" />

            <com.rama.okapi_zero.widgets.WdCollapsibleSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:defaultExpanded="true"
                app:header="@string/header_data"
                app:key="settings:section:data">

                <Button
                    android:id="@+id/export_btn"
                    style="@style/BTN_Danger"
                    android:text="@string/btn_export" />

                <View style="@style/SeparatorListVertical" />

                <Button
                    android:id="@+id/import_btn"
                    style="@style/BTN_Danger"
                    android:text="@string/btn_import" />

                <View style="@style/SeparatorListVertical" />

                <TextView
                    android:id="@+id/data_status"
                    style="@style/Text"
                    android:text="@string/label_data_warning"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />
            </com.rama.okapi_zero.widgets.WdCollapsibleSection>

            <View style="@style/SeparatorListVertical" />

            <LinearLayout
                android:id="@+id/themes_container"
                style="@style/VerticalList">

                <com.rama.okapi_zero.widgets.WdCollapsibleSection
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:defaultExpanded="true"
                    app:header="@string/header_theme"
                    app:key="settings:section:theme">

                    <com.rama.okapi_zero.widgets.WdRadioGroup
                        android:id="@+id/theme_group"
                        style="@style/VerticalList_BG2" />
                </com.rama.okapi_zero.widgets.WdCollapsibleSection>

                <View style="@style/SeparatorListVertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View style="@style/Separator" />

    <Button
        android:id="@+id/about_button"
        style="@style/BTN"
        android:text="@string/btn_about" />

    <View style="@style/SeparatorListVertical" />

    <Button
        android:id="@+id/go_back"
        style="@style/BTN"
        android:text="@string/btn_go_back" />
</LinearLayout>