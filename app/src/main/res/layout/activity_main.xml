<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    style="@style/VerticalList"
    android:layout_height="match_parent"
    android:background="@color/base"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/toolbar_row"
        style="@style/HorizontalList">

        <LinearLayout
            android:id="@+id/search_box"
            style="@style/HorizontalList"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:background="@color/surface_0">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <ImageView
                    style="@style/Icon24"
                    android:src="@drawable/px_search" />
            </FrameLayout>

            <EditText
                android:id="@+id/search"
                style="@style/EditText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:background="@color/surface_0"
                android:hint="@string/hint_search"
                android:imeOptions="actionSearch"
                android:inputType="textNoSuggestions"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <FrameLayout
                android:id="@+id/clear_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:visibility="gone">

                <ImageView
                    style="@style/Icon24"
                    android:contentDescription="@string/altdescr_clear_search"
                    android:src="@drawable/px_times" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/settings_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/small"
            android:paddingBottom="@dimen/small"
            android:paddingLeft="@dimen/small"
            >

            <ImageView
                style="@style/Icon24"
                android:contentDescription="@string/altdescr_open_settings"
                android:src="@drawable/px_cog" />
        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/list_view"
        style="@style/VerticalList"
        android:layout_height="0dp"
        android:layout_weight="1">

        <View style="@style/SeparatorListVertical" />

        <ListView
            android:id="@+id/messages_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fadingEdge="none"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/empty_label"
            style="@style/H2_Center"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/label_no_messages" />

        <LinearLayout
            android:id="@+id/menu_bar"
            style="@style/HorizontalList_BG2"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/multi_select_cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12sp">

                <ImageView
                    style="@style/Icon24"
                    android:contentDescription="@string/altdescr_cancel_selection"
                    android:src="@drawable/px_arrow_left" />
            </FrameLayout>

            <TextView
                android:id="@+id/selected_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <FrameLayout
                android:id="@+id/archive_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12sp">

                <ImageView
                    style="@style/Icon24"
                    android:contentDescription="@string/altdescr_archive"
                    android:src="@drawable/px_eye_cross" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/move_to_group_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12sp">

                <ImageView
                    style="@style/Icon24"
                    android:contentDescription="@string/altdescr_move_to_group"
                    android:src="@drawable/px_folder_enter" />
            </FrameLayout>
        </LinearLayout>

        <View style="@style/SeparatorListVertical" />

        <Button
            android:id="@+id/add_btn"
            style="@style/BTN"
            android:text="@string/btn_add_message" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/edit_view"
        style="@style/VerticalList"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdge="none"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout style="@style/VerticalList">

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_name" />

                    <View style="@style/SeparatorListVertical" />

                    <EditText
                        android:id="@+id/field_name"
                        style="@style/EditText"
                        android:inputType="textNoSuggestions" />
                </LinearLayout>

                <View style="@style/SeparatorListVertical" />

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_user" />

                    <View style="@style/SeparatorListVertical" />

                    <EditText
                        android:id="@+id/field_user"
                        style="@style/EditText"
                        android:inputType="textNoSuggestions" />
                </LinearLayout>

                <View style="@style/SeparatorListVertical" />

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_password" />

                    <View style="@style/SeparatorListVertical" />

                    <EditText
                        android:id="@+id/field_password"
                        style="@style/EditText"
                        android:inputType="textVisiblePassword" />
                </LinearLayout>

                <View style="@style/SeparatorListVertical" />

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_url" />

                    <View style="@style/SeparatorListVertical" />

                    <EditText
                        android:id="@+id/field_url"
                        style="@style/EditText"
                        android:inputType="textUri|textNoSuggestions" />
                </LinearLayout>

                <View style="@style/SeparatorListVertical" />

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_totp" />

                    <View style="@style/SeparatorListVertical" />

                    <EditText
                        android:id="@+id/field_totp"
                        style="@style/EditText"
                        android:inputType="textVisiblePassword" />
                </LinearLayout>

                <View style="@style/SeparatorListVertical" />

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_group" />

                    <View style="@style/SeparatorListVertical" />

                    <TextView
                        android:id="@+id/field_group"
                        style="@style/EditText"
                        android:clickable="true" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <View style="@style/Separator" />

        <Button
            android:id="@+id/save_btn"
            style="@style/BTN"
            android:text="@string/btn_save" />

        <View style="@style/SeparatorListVertical" />

        <Button
            android:id="@+id/delete_btn"
            style="@style/BTN_Danger"
            android:text="@string/btn_delete" />

        <View style="@style/SeparatorListVertical" />

        <!--        <Button-->
        <!--            android:id="@+id/archive_btn"-->
        <!--            style="@style/BTN_Danger"-->
        <!--            android:text="@string/btn_archive" />-->

        <!--        <View style="@style/SeparatorListVertical" />-->

        <Button
            android:id="@+id/cancel"
            style="@style/BTN"
            android:text="@string/btn_go_back" />
    </LinearLayout>
</LinearLayout>