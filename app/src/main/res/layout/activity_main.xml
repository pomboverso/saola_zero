<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    style="@style/VerticalList"
    android:layout_height="match_parent"
    android:background="@color/base">

    <LinearLayout
        android:id="@+id/toolbar_row"
        style="@style/HorizontalList"
        android:padding="4sp">

        <LinearLayout
            style="@style/HorizontalList"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:background="@color/surface_0">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <ImageView
                    style="@style/Icon24"
                    android:src="@drawable/px_search" />
            </FrameLayout>

            <EditText
                android:id="@+id/search"
                style="@style/EditText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:background="@color/surface_0"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <FrameLayout
                android:id="@+id/clear_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <ImageView
                    style="@style/Icon24"
                    android:src="@drawable/px_times" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/sort_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/small">

            <ImageView
                style="@style/Icon24"
                android:contentDescription="@string/altdescr_sort"
                android:src="@drawable/px_sort" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/settings_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/small">

            <ImageView
                style="@style/Icon24"
                android:contentDescription="@string/altdescr_open_settings"
                android:src="@drawable/px_cog" />
        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/list_view"
        style="@style/VerticalList"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/messages_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fadingEdge="none"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/empty_label"
            style="@style/H2_Center"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/label_no_messages" />

        <Button
            android:id="@+id/add_btn"
            style="@style/BTN"
            android:layout_margin="16dp"
            android:text="@string/btn_add_message" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/edit_view"
        style="@style/VerticalList"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdge="none"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout style="@style/VerticalList">

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_name" />

                    <View style="@style/SeparatorListVertical" />

                    <EditText
                        android:id="@+id/field_name"
                        style="@style/EditText"
                        android:inputType="textNoSuggestions" />
                </LinearLayout>

                <View style="@style/SeparatorListVertical" />

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_user" />

                    <View style="@style/SeparatorListVertical" />

                    <EditText
                        android:id="@+id/field_user"
                        style="@style/EditText"
                        android:inputType="textNoSuggestions" />
                </LinearLayout>

                <View style="@style/SeparatorListVertical" />

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_password" />

                    <View style="@style/SeparatorListVertical" />

                    <EditText
                        android:id="@+id/field_password"
                        style="@style/EditText"
                        android:inputType="textVisiblePassword" />
                </LinearLayout>

                <View style="@style/SeparatorListVertical" />

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_url" />

                    <View style="@style/SeparatorListVertical" />

                    <EditText
                        android:id="@+id/field_url"
                        style="@style/EditText"
                        android:inputType="textUri|textNoSuggestions" />
                </LinearLayout>

                <View style="@style/SeparatorListVertical" />

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_totp" />

                    <View style="@style/SeparatorListVertical" />

                    <EditText
                        android:id="@+id/field_totp"
                        style="@style/EditText"
                        android:inputType="textVisiblePassword" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <View style="@style/Separator" />

        <Button
            android:id="@+id/save_btn"
            style="@style/BTN"
            android:text="@string/btn_save" />

        <View style="@style/SeparatorListVertical" />

        <!--        <Button-->
        <!--            android:id="@+id/delete_btn"-->
        <!--            style="@style/BTN_Danger"-->
        <!--            android:text="@string/btn_delete" />-->

        <Button
            android:id="@+id/archive_btn"
            style="@style/BTN_Danger"
            android:text="@string/btn_archive" />

        <View style="@style/SeparatorListVertical" />

        <Button
            android:id="@+id/cancel"
            style="@style/BTN"
            android:text="@string/btn_go_back" />
    </LinearLayout>
</LinearLayout>