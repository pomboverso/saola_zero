<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/message_row"
    style="@style/HorizontalList"
    android:background="@color/base">

    <FrameLayout
        android:id="@+id/ascend_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/small">

        <ImageView
            android:id="@+id/ascend_icon"
            style="@style/Icon24"
            android:contentDescription="@string/altdescr_move_up"
            android:src="@drawable/px_chevron_up"
            android:tag="accent" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/descend_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/small">

        <ImageView
            android:id="@+id/descend_icon"
            style="@style/Icon24"
            android:contentDescription="@string/altdescr_move_down"
            android:src="@drawable/px_chevron_down"
            android:tag="accent" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/small">

        <ImageView
            android:id="@+id/message_icon"
            style="@style/Icon24"
            android:src="@drawable/px_message"
            android:tag="success" />
    </FrameLayout>

    <TextView
        android:id="@+id/row_text"
        style="@style/Text"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:paddingLeft="@dimen/space_between_elements"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:singleLine="true" />
</LinearLayout>
